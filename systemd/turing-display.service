[Unit]
Description=Turing smart screen display platform (standard/carousel/netmap via display.yaml)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jacquesb
SupplementaryGroups=dialout
WorkingDirectory=/home/jacquesb/turing-smart-screen
ExecStart=/home/jacquesb/turing-smart-screen/venv/bin/python display.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
